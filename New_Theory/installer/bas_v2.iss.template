; Bolt Analysis Studio - instalador auto-contido
; GERADO por New_Theory/build_installer.py a partir deste template.
; Nao editar o .iss gerado em _build/: editar ESTE arquivo.
;
; Versao e autores vem do setup.py, que e' a fonte unica dos dois. Os campos
; @MAIUSCULO@ sao substituidos por _render_iss; usa-se @...@ e nao str.format
; porque o .iss e' cheio de {app}, {group} e {localappdata}, que format()
; tentaria interpretar como placeholder.

[Setup]
AppId={{8E4C1F2A-6B7D-4A91-9C3E-BA52V2INSTALL}
AppName=Bolt Analysis Studio
AppVersion=@VERSION@
AppPublisher=@AUTHOR@
AppPublisherURL=https://github.com/leonardorrs190891/bolt-analysis-studio
DefaultDirName={localappdata}\Programs\Bolt Analysis Studio
DefaultGroupName=Bolt Analysis Studio
OutputDir=@OUTDIR@
OutputBaseFilename=BAS-Setup-@VERSION@
SetupIconFile=@ICO@
UninstallDisplayIcon={app}\bas.ico
UninstallDisplayName=Bolt Analysis Studio @VERSION@
LicenseFile=@BUILDDIR@\LICENSE
; por usuario: sem UAC, e e' o que faz sentido para uma ferramenta cientifica
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
DisableProgramGroupPage=yes

[Languages]
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; O destino E' o repo root: repo_root() sobe 3 niveis de
; src/bolt_analysis_studio/validation/inputs.py e tem de cair em {app}.
Source: "@BUILDDIR@\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Aponta para o pythonw.exe EMBUTIDO, nao para um shim compilado: e' isso que
; mantem sys.executable sendo um Python real, que e' a razao da pilha.
; --skip-deps-check porque as dependencias vao embutidas e pythonw.exe nao tem
; console onde uma mensagem do preflight pudesse aparecer.
Name: "{group}\Bolt Analysis Studio"; Filename: "{app}\python\pythonw.exe"; Parameters: """{app}\run_app.py"" --skip-deps-check"; WorkingDir: "{app}"; IconFilename: "{app}\bas.ico"
Name: "{group}\Leia-me (como usar)"; Filename: "{app}\LEIAME.html"
Name: "{group}\Dados de calibracao por artigo"; Filename: "{app}\New_Theory\variable_explorer\index.html"
Name: "{group}\Diagnostico (console)"; Filename: "{app}\BAS-console.cmd"; WorkingDir: "{app}"
Name: "{autodesktop}\Bolt Analysis Studio"; Filename: "{app}\python\pythonw.exe"; Parameters: """{app}\run_app.py"" --skip-deps-check"; WorkingDir: "{app}"; IconFilename: "{app}\bas.ico"; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "Criar atalho na area de trabalho"; GroupDescription: "Atalhos adicionais:"

[Run]
Filename: "{app}\LEIAME.html"; Description: "Ver o leia-me: como usar e onde estao os dados de calibracao"; Flags: postinstall shellexec skipifsilent nowait
Filename: "{app}\python\pythonw.exe"; Parameters: """{app}\run_app.py"" --skip-deps-check"; WorkingDir: "{app}"; Description: "Abrir o Bolt Analysis Studio"; Flags: postinstall nowait skipifsilent unchecked
